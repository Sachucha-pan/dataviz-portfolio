{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Популярність серед жінок",

  "width": 250,

  "data": {
    "url": "https://raw.githubusercontent.com/Sachucha-pan/dataviz-portfolio/main/specs/Drug_Consumption.csv"
  },

  "transform": [
    {
      "filter": "datum.Gender == 'F'"
    },
    {
      "fold": [
        "Alcohol",
        "Amphet",
        "Amyl",
        "Benzos",
        "Caff",
        "Cannabis",
        "Choc",
        "Coke",
        "Crack",
        "Ecstasy",
        "Heroin",
        "Ketamine",
        "Legalh",
        "LSD",
        "Meth",
        "Mushrooms",
        "Nicotine",
        "VSA"
      ],
      "as": ["Drug", "Usage"]
    },
    {
      "calculate": "datum.Usage == 'CL0' ? 0 : 1",
      "as": "User"
    }
  ],

"layer": [
  {
    "mark": {
      "type": "bar",
      "cornerRadiusEnd": 5,
      "color": "#DC2626"
    },
    "encoding": {
      "y": {
        "field": "Drug",
        "type": "nominal",
        "sort": "-x",
        "title": "Речовина"
      },
      "x": {
        "aggregate": "mean",
        "field": "User",
        "type": "quantitative",
        "title": "Частка користувачів",
        "axis": {
          "format": ".0%"
        }
      }
    }
  },
  {
    "mark": {
      "type": "text",
      "align": "left",
      "baseline": "middle",
      "dx": 5,
      "fontSize": 11,
      "fontWeight": "bold",
      "color": "#991B1B"
    },
    "encoding": {
      "y": {
        "field": "Drug",
        "type": "nominal",
        "sort": "-x"
      },
      "x": {
        "aggregate": "mean",
        "field": "User",
        "type": "quantitative"
      },
      "text": {
        "aggregate": "mean",
        "field": "User",
        "type": "quantitative",
        "format": ".0%"
      }
    }
  }
]
}

  
